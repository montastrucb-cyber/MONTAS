# Copiez ce fichier en « .env.local » (jamais envoyé sur GitHub) et remplissez les valeurs.
# Sur Vercel : Project → Settings → Environment Variables.

# Adresse publique du site, une fois votre domaine choisi (active l'indexation Google).
NEXT_PUBLIC_SITE_URL=

# Envoi des demandes de devis par email (optionnel) — https://resend.com (offre gratuite : 3 000 emails/mois)
# Ces clés sont lues uniquement côté serveur (src/app/api/devis/route.ts).
RESEND_API_KEY=
QUOTE_TO_EMAIL=
QUOTE_FROM_EMAIL=
